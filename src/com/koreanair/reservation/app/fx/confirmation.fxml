<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.koreanair.reservation.app.fx.screen.ConfirmationController"
      styleClass="screen">

    <Label text="예약 완료 ✈️" styleClass="screen-title"/>

    <VBox styleClass="card" spacing="16" maxWidth="520">
        <VBox spacing="4">
            <Label text="예약번호 (PNR)" styleClass="kv-key"/>
            <Label fx:id="pnrLabel" styleClass="big-pnr"/>
        </VBox>
        <HBox spacing="24">
            <VBox spacing="4">
                <Label text="현재 상태 (State)" styleClass="kv-key"/>
                <Label fx:id="stateLabel" styleClass="kv-val"/>
            </VBox>
            <VBox spacing="4">
                <Label text="결제 금액" styleClass="kv-key"/>
                <Label fx:id="amountLabel" styleClass="kv-val"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <Button text="e-Ticket 발급 (→ Ticketed)" styleClass="btn-ghost" onAction="#onIssueTicket"/>
        </HBox>

        <VBox styleClass="card" spacing="8">
            <Label text="우등고속 셔틀버스 연계 (Observer 패턴)" styleClass="field-label"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="busCityCombo" prefWidth="220"/>
                <Button text="셔틀 발권" styleClass="btn-ghost" onAction="#onLinkBus"/>
            </HBox>
            <Label fx:id="busLabel" styleClass="kv-val"/>
        </VBox>

        <Label fx:id="message" styleClass="ok-text"/>

        <HBox spacing="10">
            <Button fx:id="lookupBtn" text="내 예약 보기" styleClass="btn-ghost" onAction="#onLookup"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="새 예약 시작" styleClass="btn-primary" onAction="#onNew"/>
        </HBox>
    </VBox>
</VBox>
