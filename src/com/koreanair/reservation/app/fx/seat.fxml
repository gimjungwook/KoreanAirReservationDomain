<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.koreanair.reservation.app.fx.screen.SeatController"
      styleClass="screen">

    <Label text="좌석 선택" styleClass="screen-title"/>
    <Label text="좌석을 고르면 창측/통로 여부가 Decorator 체인으로 자동 표시됩니다. 부가 옵션을 더할 수 있습니다." styleClass="screen-sub"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="content">
            <VBox styleClass="card" alignment="CENTER" spacing="12">
                <GridPane fx:id="seatGrid" hgap="6" vgap="6"/>
            </VBox>
        </ScrollPane>

        <!-- Decorator 정보 패널 -->
        <VBox styleClass="card" spacing="12" minWidth="280" maxWidth="320">
            <Label text="좌석 정보 (Decorator)" styleClass="section-title"/>
            <Label fx:id="selectedLabel" styleClass="kv-val"/>
            <Label fx:id="seatDescLabel" styleClass="screen-sub" wrapText="true"/>
            <Label fx:id="seatMetaLabel" styleClass="flight-meta" wrapText="true"/>
            <Region minHeight="6"/>
            <Label text="부가 옵션" styleClass="field-label"/>
            <CheckBox fx:id="legroomCheck" text="추가 레그룸 (+₩50,000)"/>
            <CheckBox fx:id="loungeCheck" text="라운지 이용 (+₩80,000)"/>
            <Region minHeight="6"/>
            <Label fx:id="surchargeLabel" styleClass="total-amt"/>
        </VBox>
    </HBox>

    <Label fx:id="message" styleClass="error-text"/>
    <HBox spacing="10">
        <Button text="이전" styleClass="btn-ghost" onAction="#onBack"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="결제로" styleClass="btn-primary" onAction="#onNext"/>
    </HBox>
</VBox>
