<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.koreanair.reservation.app.fx.screen.PaymentController"
      styleClass="screen">

    <Label text="결제" styleClass="screen-title"/>
    <Label text="결제 완료 시 예약 상태가 PendingPayment → Confirmed 로 전이됩니다 (State 패턴)." styleClass="screen-sub"/>

    <VBox styleClass="card" spacing="14" maxWidth="480">
        <HBox spacing="10">
            <Label text="예약번호" styleClass="kv-key"/>
            <Label fx:id="pnrLabel" styleClass="kv-val"/>
        </HBox>

        <VBox spacing="4">
            <Label text="결제 수단 (Factory Method)" styleClass="field-label"/>
            <ComboBox fx:id="methodCombo" prefWidth="200"/>
        </VBox>

        <VBox styleClass="card" spacing="8">
            <CheckBox fx:id="busAddon" text="우등고속 셔틀버스 연계 발권 (Observer 시연)"/>
            <Label text="출발 도시" styleClass="field-label"/>
            <ComboBox fx:id="busCityCombo" prefWidth="240"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="결제 총액" styleClass="kv-key"/>
            <Label fx:id="totalLabel" styleClass="total-amt"/>
        </HBox>

        <Label fx:id="message" styleClass="error-text"/>
        <HBox spacing="10">
            <Button text="이전" styleClass="btn-ghost" onAction="#onBack"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="결제하기" styleClass="btn-primary" onAction="#onPay"/>
        </HBox>
    </VBox>
</VBox>
