<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.koreanair.reservation.app.fx.screen.LookupController"
      styleClass="screen">

    <Label text="예약 조회" styleClass="screen-title"/>

    <ScrollPane fitToWidth="true" prefHeight="280" styleClass="content">
        <VBox fx:id="memberList" spacing="10"/>
    </ScrollPane>

    <VBox styleClass="card" spacing="10" maxWidth="520">
        <Label text="비회원 PNR 조회" styleClass="field-label"/>
        <HBox spacing="10">
            <TextField fx:id="pnrField" promptText="PNR" prefWidth="180"/>
            <TextField fx:id="nameField" promptText="이름" prefWidth="120"/>
            <TextField fx:id="emailField" promptText="이메일" prefWidth="180"/>
        </HBox>
        <Button text="조회" styleClass="btn-primary" onAction="#onGuestLookup"/>
        <Label fx:id="message" styleClass="error-text"/>
    </VBox>
</VBox>
