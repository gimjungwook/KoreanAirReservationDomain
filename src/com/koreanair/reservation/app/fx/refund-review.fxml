<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.koreanair.reservation.app.fx.screen.RefundReviewController"
      styleClass="screen">

    <Label text="환불 검토 대기열 (담당자)" styleClass="screen-title"/>
    <Label text="환불 정책(Strategy)으로 산정된 요청을 승인 또는 거절합니다." styleClass="screen-sub"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content">
        <VBox fx:id="queue" spacing="10"/>
    </ScrollPane>

    <Label fx:id="message" styleClass="ok-text"/>
    <Button text="홈으로" styleClass="btn-ghost" onAction="#onBack"/>
</VBox>
