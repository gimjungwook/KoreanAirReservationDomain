@startuml sequence-connecting-search
title Sequence: Connecting Flight Search with MCT Validation (Iteration 3)
skinparam sequenceMessageAlign center
skinparam sequenceFontSize 11
skinparam shadowing false
skinparam dpi 130
skinparam sequenceArrowThickness 1.2
skinparam sequenceLifeLineBorderColor #888
hide footbox
autonumber

actor User
participant "ReservationUI" as UI
participant "ItinerarySearch\nService" as ISS
participant "FlightSearch\nService" as FSS
participant "Itinerary" as It

User -> UI : searchConnecting(ICN, JFK, date)
activate UI
UI -> ISS : searchConnecting(from, to, date, MCT=90m)
activate ISS
ISS -> FSS : getCatalog()
activate FSS
FSS --> ISS : List<FlightSchedule>
deactivate FSS

note over ISS
  Iterate candidate flight pairs (a, b)
  where a.dest == b.origin and b.dest == JFK
end note

loop candidate flight pairs
  ISS -> It : Itinerary.connecting(a, b)
  activate It
  ISS -> It : isConnectionTimeValid(MCT)
  note right of It
    layover = b.departure - a.arrival
  end note
  alt layover >= MCT
    It --> ISS : pass
  else layover < MCT
    It --> ISS : reject
  end
  deactivate It
end

ISS --> UI : List<Itinerary>
deactivate ISS
UI --> User : render passing itineraries
deactivate UI
@enduml
