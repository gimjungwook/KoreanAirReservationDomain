@startuml sequence-payment-failure
title Sequence: Payment Failure Auto-Cancel (Iteration 3 - Observer demo)
skinparam sequenceMessageAlign center
skinparam sequenceFontSize 12

actor Member
participant "ReservationUI" as UI
participant "BookingController" as BC
participant "PaymentProcessor\n(Subject)" as PP
participant "PaymentGateway\n(mock)" as PG
participant "ReservationAuto\nCancelListener" as L
participant "Reservation" as R
database "Reservation\nRegistry" as Reg

Member -> UI : submitPayment(info)
UI -> BC : confirmPayment(reservation, fareRule, ...)
BC -> PP : processPaymentCharge(amount, pnr)
PP -> PG : authorize(payment)
PG --> PP : returns false
PP -> PP : payment.fail()
PP -> PP : publish(PaymentFailedEvent("gateway-declined", pnr))
PP -> L : onEvent(event)
L -> Reg : findByPnr(pnr)
Reg --> L : returns Reservation
L -> R : handlePaymentFailure()
R -> R : state.transition()\nPendingPayment -> Cancelled
R --> L : ok
L --> PP : (no return)

note over PP, L
  The publisher does not know the
  listener's class - registration time
  binding only.
end note
@enduml
