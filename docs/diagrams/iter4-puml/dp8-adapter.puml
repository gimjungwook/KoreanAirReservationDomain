@startuml dp8-adapter
!include _style.puml
title DP#8 Adapter - 외부 Skypass API 인터페이스 변환
interface SkypassInterface <<Target>> #FFCCCC {
  +verifyMembership(): Object
  +getMileageBalance(): int
  +deductMileage(): boolean
  +verifyAndDeduct(): Object
}
class SkypassAdapter <<Adapter>> #FFCCCC {
  -remoteApi: RemoteSkypassApi
  --
  +verifyMembership(): Object
  +getMileageBalance(): int
  +deductMileage(): boolean
  +verifyAndDeduct(): Object
}
class RemoteSkypassApi <<Adaptee>> #FFCCCC {
  -balances: Map<String,Integer>
  -tokens: Map<String,String>
  --
  +registerAccount(): void
  +postAuth(): Map<String,Object>
  +getMileage(): Map<String,Object>
  +postDeduct(): Map<String,Object>
}
class PaymentController <<Client>>
PaymentController -right-> SkypassInterface : 마일리지 잔액/결제
SkypassInterface <|.. SkypassAdapter
SkypassAdapter -right-> RemoteSkypassApi : adaptee
note bottom of SkypassAdapter : 외부 API를 우리 인터페이스로 변환
@enduml
