@startuml tb-composite
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "Lucida Grande"
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
  HeaderBackgroundColor #FFFFCE
}
skinparam legendBackgroundColor #FFFFFF

title 그림 14-7 대응 — Composite (공항/도시) (iteration 4)
abstract class AirportLocation <<Component>> #line:red;line.bold {
  +{abstract} matches(code): boolean
  +{abstract} getAirports(): List<Airport>
}
class Airport <<Leaf>> #line:red;line.bold {
  +matches(code): boolean
  +getAirports(): List<Airport>
}
class AirportCity <<Composite>> #line:red;line.bold {
  -components: List<AirportLocation>
  --
  +addComponent(AirportLocation): void
  +removeComponent(AirportLocation): void
  +getAirports(): List<Airport>
}
AirportLocation <|-- Airport
AirportLocation <|-- AirportCity
AirportCity o--> "0..*" AirportLocation : -components
note bottom of AirportCity
  operation(getAirports) 은 자식 components 를 재귀 순회 (그림의 for c in components)
end note
legend bottom
  <#FFFFCE>|= 표기 |= 의미 |
  |<#FFFFCE> 노란 박스 | iteration 1-3 기존 |
  | <color:red>빨강 테두리/글자</color> | iteration 4 신규/수정 |
endlegend
@enduml