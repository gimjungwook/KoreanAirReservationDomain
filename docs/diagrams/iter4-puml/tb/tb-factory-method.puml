@startuml tb-factory-method
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "Lucida Grande"
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
  HeaderBackgroundColor #FFFFCE
}
skinparam legendBackgroundColor #FFFFFF

title 그림 12-7 대응 — Factory Method (결제) (iteration 4)
abstract class PaymentMethodProcessor <<Creator>> #line:red;line.bold {
  +processCharge(amount, pnr): Payment
  +{abstract} createPayment(): Payment
}
abstract class Payment <<Product>> #line:red;line.bold {
  #Payment(PaymentMethod)
  +pay(): void
}
class CreditCardPaymentProcessor <<ConcreteCreator>> #line:red;line.bold {
  +createPayment(): Payment
}
class CreditCardPayment <<ConcreteProduct>> #line:red;line.bold {
}
PaymentMethodProcessor <|-- CreditCardPaymentProcessor
Payment <|-- CreditCardPayment
CreditCardPaymentProcessor ..> CreditCardPayment : creates
note right of PaymentMethodProcessor
  anOperation(processCharge) 가 factoryMethod(createPayment()) 호출.
  ConcreteCreator: ApplePay/BankTransfer/KakaoPay/Mileage (+Payment 5종)
end note
legend bottom
  <#FFFFCE>|= 표기 |= 의미 |
  |<#FFFFCE> 노란 박스 | iteration 1-3 기존 |
  | <color:red>빨강 테두리/글자</color> | iteration 4 신규/수정 |
endlegend
@enduml