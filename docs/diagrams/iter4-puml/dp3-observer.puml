@startuml dp3-observer
!include _style.puml
title DP#3 Observer - 이벤트 1대N 전파
abstract class EventPublisher <<Subject>> {
  -observers: List<EventListener>
  --
  +attach(): void
  +detach(): void
  +subscriberCount(): int
  +notifyObservers(): void
}
interface EventListener <<Observer>> {
  +update(): void
}
abstract class DomainEvent {
  -occurredAt: LocalDateTime
  -sourceId: String
  --
  +getOccurredAt(): LocalDateTime
  +getSourceId(): String
  +getEventType(): String
}
class TicketPurchasePublisher {
  -subjectState: TicketIssuedEvent
  --
  +getState(): TicketIssuedEvent
  +setState(): void
  +publishTicketIssued(): void
}
class BusTicketPurchaseListener {
  -busTicketingService: BusTicketingService
  -subject: TicketPurchasePublisher
  --
  +setSubject(): void
  +getSubject(): TicketPurchasePublisher
  +update(): void
}
class ReservationAutoCancelListener {
  -subject: PaymentProcessor
  --
  +setSubject(): void
  +getSubject(): PaymentProcessor
  +update(): void
}
class TicketIssuedEvent {
  -reservation: Reservation
  -ticket: Ticket
  -busTicketRequest: BusTicketRequest
  --
  +getReservation(): Reservation
  +getTicket(): Ticket
  +getBusTicketRequest(): BusTicketRequest
  +getRequestedBusCity(): BusCity
}
class PaymentFailedEvent {
  -payment: Payment
  -reservationPnr: String
  -reason: String
  --
  +getPayment(): Payment
  +getReservationPnr(): String
  +getReason(): String
}
EventPublisher <|-- TicketPurchasePublisher
EventListener <|.. BusTicketPurchaseListener
EventListener <|.. ReservationAutoCancelListener
DomainEvent <|-- TicketIssuedEvent
DomainEvent <|-- PaymentFailedEvent
EventPublisher o--> EventListener : notifies
note bottom : e-Ticket 발권 to 버스티켓 자동 발매
@enduml
