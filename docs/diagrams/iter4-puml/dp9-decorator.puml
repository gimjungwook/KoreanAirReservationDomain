@startuml dp9-decorator
!include _style.puml
title DP#9 Decorator - 좌석 부가옵션 누적
abstract class SeatView <<Component>> #FFCCCC {
  +getSeat(): Seat
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
}
class SeatViewAdapter <<ConcreteComponent>> #FFCCCC {
  -seat: Seat
  --
  +getSeat(): Seat
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
}
abstract class AbstractSeatDecorator <<Decorator>> #FFCCCC {
  #component: SeatView
  --
  +getSeat(): Seat
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
}
class WindowSeatDecorator #FFCCCC {
  +getDescription(): String
  +getMetadataLabels(): List<String>
  -addedLabel(): String
}
class AisleSeatDecorator #FFCCCC {
  +getDescription(): String
  +getMetadataLabels(): List<String>
  -addedLabel(): String
}
class ExtraLegroomDecorator #FFCCCC {
  -SURCHARGE: BigDecimal
  --
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
  -addedLabel(): String
}
class LoungeAccessDecorator #FFCCCC {
  -SURCHARGE: BigDecimal
  --
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
  -addedLabel(): String
}
SeatView <|-- SeatViewAdapter
SeatView <|-- AbstractSeatDecorator
AbstractSeatDecorator o--> SeatView : component
AbstractSeatDecorator <|-- WindowSeatDecorator
AbstractSeatDecorator <|-- AisleSeatDecorator
AbstractSeatDecorator <|-- ExtraLegroomDecorator
AbstractSeatDecorator <|-- LoungeAccessDecorator
note bottom : 창측+레그룸(+5만)+라운지(+8만) 런타임 체인
@enduml
