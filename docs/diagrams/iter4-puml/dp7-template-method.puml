@startuml dp7-template-method
!include _style.puml
title DP#7 Template Method - e-Ticket 렌더 골격 고정
abstract class TicketRenderer <<AbstractClass>> {
  +render(): String
  #header(): String
  #body(): String
  #footer(): String
  #separator(): String
}
class PlainTextTicketRenderer {
  #header(): String
  #body(): String
  #footer(): String
  #separator(): String
  -safe(): String
}
class HtmlTicketRenderer {
  #header(): String
  #body(): String
  #footer(): String
  #separator(): String
  -safe(): String
}
class BoardingPassRenderer {
  #header(): String
  #body(): String
  #footer(): String
  #separator(): String
  -safe(): String
}
TicketRenderer <|-- PlainTextTicketRenderer
TicketRenderer <|-- HtmlTicketRenderer
TicketRenderer <|-- BoardingPassRenderer
note bottom of TicketRenderer : render() 골격 고정, 단계만 위임
@enduml
