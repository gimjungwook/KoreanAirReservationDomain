@startuml dp7-adapter
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype polyline
skinparam nodesep 26
skinparam ranksep 42
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  ArrowThickness 1
  FontColor #000000
  FontName "Helvetica Neue"
  AttributeFontColor #000000
  AttributeFontName "Helvetica Neue"
  StereotypeFontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #000000
}

title DP#8 Adapter Pattern - SkypassAdapter
class AppContext <<Client>> {
  +skypass: SkypassInterface
}
interface SkypassInterface <<Target>> {
  +verifyMembership(skypassNumber: String, password: String): Object
  +getMileageBalance(skypassNumber: String): int
  +deductMileage(skypassNumber: String, amount: int): boolean
  +verifyAndDeduct(skypassNumber: String, amount: int): Object
}
class SkypassAdapter <<Adapter>> {
  -adaptee: RemoteSkypassApi
  --
  +SkypassAdapter(adaptee: RemoteSkypassApi)
  +verifyMembership(skypassNumber: String, password: String): Object
  +getMileageBalance(skypassNumber: String): int
  +deductMileage(skypassNumber: String, amount: int): boolean
  +verifyAndDeduct(skypassNumber: String, amount: int): Object
}
class RemoteSkypassApi <<Adaptee>> {
  -balances: Map<String,Integer>
  -tokens: Map<String,String>
  --
  +registerAccount(memberCode: String, token: String, mileage: int): void
  +postAuth(memberCode: String, token: String): Map<String,Object>
  +getMileage(memberCode: String): Map<String,Object>
  +postDeduct(memberCode: String, amount: int): Map<String,Object>
}
AppContext --> SkypassInterface
SkypassInterface <|.. SkypassAdapter
SkypassAdapter --> RemoteSkypassApi : -adaptee
note bottom : AppContext is the Client and depends only on SkypassInterface.\nFxApp wires SkypassAdapter(adaptee) into AppContext; deductMileage converts adaptee.postDeduct -> success.
@enduml
