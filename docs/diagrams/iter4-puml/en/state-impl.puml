@startuml state-impl
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype polyline
skinparam nodesep 26
skinparam ranksep 50
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  ArrowThickness 1
  FontColor #000000
  FontName "Helvetica Neue"
  AttributeFontColor #000000
  AttributeFontName "Helvetica Neue"
  StereotypeFontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #000000
}

title DP#1 State Pattern - Context = Reservation

class Reservation <<Context>> {
  -reservationId: Long
  -reservationNumber: String
  -requester: User
  -status: ReservationStatus
  -createdAt: LocalDateTime
  -reservationDate: LocalDateTime
  -itinerary: Itinerary
  -passengers: List<Passenger>
  -reservationItems: List<ReservationItem>
  -payments: List<Payment>
  -tickets: List<Ticket>
  -currentState: ReservationState
  --
  +Reservation()
  +getReservationId(): Long
  +getReservationNumber(): String
  +getRequester(): User
  +getStatus(): ReservationStatus
  +getPassengers(): List<Passenger>
  +getReservationItems(): List<ReservationItem>
  +getPayments(): List<Payment>
  +getTickets(): List<Ticket>
  +getItinerary(): Itinerary
  +addPassenger(passenger: Passenger): void
  +addReservationItem(reservationItem: ReservationItem): void
  +addPayment(payment: Payment): void
  +addTicket(ticket: Ticket): void
  +canBeCancelled(): boolean
  +evaluateImpactOfFlightStatusChange(): void
  +updateStatus(newStatus: ReservationStatus): void
  +findByPnr(pnr: String): Reservation {static}
  +setState(next: ReservationState): void
  +getCurrentState(): ReservationState
  +getStateName(): String
  +enterPassengerInfo(p: Passenger): void
  +enterPassengerInfo(): void
  +processPayment(): void
  +handlePaymentFailure(): void
  +issueTicket(): void
  +requestCancellation(): void
  +confirmCancellation(): void
  +requestRefund(): void
  +processRefundDecision(approved: boolean): void
  +setReservationNumber(reservationNumber: String): void
  +setRequester(requester: User): void
  +getPnrNumber(): String
  +getCreatedAt(): LocalDateTime
  +getReservationDate(): LocalDateTime
}

interface ReservationState <<State>> {
  +name(): String
  --
  +enterPassengerInfo(ctx: Reservation): void {default}
  +processPayment(ctx: Reservation): void {default}
  +handlePaymentFailure(ctx: Reservation): void {default}
  +issueTicket(ctx: Reservation): void {default}
  +requestCancellation(ctx: Reservation): void {default}
  +confirmCancellation(ctx: Reservation): void {default}
  +requestRefund(ctx: Reservation): void {default}
  +processRefundDecision(ctx: Reservation, approved: boolean): void {default}
}

class InvalidStateTransitionException <<Exception>> {
  +InvalidStateTransitionException(currentState: String, action: String)
}
class RuntimeException <<JDK>> {
}

' Concrete states laid out as two rows of four (top row = forward/happy path,
' bottom row = cancellation / refund branch) so the eight realization arrows fan
' symmetrically into ReservationState instead of overflowing one wide row.
together {
  class InitiatedState <<ConcreteState>> {
    +name(): String
    +enterPassengerInfo(ctx: Reservation): void
  }
  class PendingPaymentState <<ConcreteState>> {
    +name(): String
    +processPayment(ctx: Reservation): void
    +handlePaymentFailure(ctx: Reservation): void
  }
  class ConfirmedState <<ConcreteState>> {
    +name(): String
    +issueTicket(ctx: Reservation): void
    +requestCancellation(ctx: Reservation): void
  }
  class TicketedState <<ConcreteState>> {
    +name(): String
    +requestCancellation(ctx: Reservation): void
  }
}

together {
  class CancellationRequestedState <<ConcreteState>> {
    +name(): String
    +confirmCancellation(ctx: Reservation): void
  }
  class CancelledState <<ConcreteState>> {
    +name(): String
    +requestRefund(ctx: Reservation): void
    -resolveFareRule(ctx: Reservation): FareRule
  }
  class RefundRequestedState <<ConcreteState>> {
    +name(): String
    +processRefundDecision(ctx: Reservation, approved: boolean): void
  }
  class RefundedState <<ConcreteState>> {
    +name(): String
  }
}

' Context HOLDS-A current state (the -currentState field). Anchored from the field
' to ReservationState's left side and forced rightward so the aggregation diamond
' stays clear of the realization fan that joins the ConcreteStates below.
Reservation::currentState "1" o-right-> ReservationState : -currentState

' Each interface default throws InvalidStateTransitionException (base reject path);
' kept to the right of the interface so the dependency never crosses the realizations.
ReservationState ..> InvalidStateTransitionException : throws on\nillegal transition
RuntimeException <|-- InvalidStateTransitionException

' Eight realizations fan downward into the interface. Only the top row realizes
' directly; the bottom row is pinned one rank lower via hidden edges (below) so the
' eight boxes form a 4+4 grid instead of one over-wide row, keeping single-page fit.
ReservationState <|.. InitiatedState
ReservationState <|.. PendingPaymentState
ReservationState <|.. ConfirmedState
ReservationState <|.. TicketedState
ReservationState <|.. CancellationRequestedState
ReservationState <|.. CancelledState
ReservationState <|.. RefundRequestedState
ReservationState <|.. RefundedState

' Layout pins: keep each row left-to-right in lifecycle order, and stack the
' cancellation/refund row one rank below the forward row (hidden, no glyph).
InitiatedState -[hidden]right- PendingPaymentState
PendingPaymentState -[hidden]right- ConfirmedState
ConfirmedState -[hidden]right- TicketedState
CancellationRequestedState -[hidden]right- CancelledState
CancelledState -[hidden]right- RefundRequestedState
RefundRequestedState -[hidden]right- RefundedState
InitiatedState -[hidden]down- CancellationRequestedState
TicketedState -[hidden]down- RefundedState

note bottom of RefundedState : Base interface defaults reject illegal transitions (throw InvalidStateTransitionException);\neach ConcreteState overrides only its allowed transitions and inherits the default rejection for the rest.\nInitial state = InitiatedState, set in the Reservation() constructor; RefundedState overrides none (final state).
@enduml
