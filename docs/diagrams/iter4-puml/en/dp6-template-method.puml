@startuml dp6-template-method
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype polyline
skinparam nodesep 26
skinparam ranksep 42
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  ArrowThickness 1
  FontColor #000000
  FontName "Helvetica Neue"
  AttributeFontColor #000000
  AttributeFontName "Helvetica Neue"
  StereotypeFontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #000000
}

title DP#7 Template Method Pattern - TicketRenderer

abstract class TicketRenderer <<AbstractClass>> {
  +render(reservation: Reservation, ticket: Ticket): String {final}
  --
  #{abstract} header(reservation: Reservation, ticket: Ticket): String
  #{abstract} body(reservation: Reservation, ticket: Ticket): String
  #{abstract} footer(reservation: Reservation, ticket: Ticket): String
  #separator(): String
}
class PlainTextTicketRenderer <<ConcreteClass>> {
  #header(reservation: Reservation, ticket: Ticket): String
  #body(reservation: Reservation, ticket: Ticket): String
  #footer(reservation: Reservation, ticket: Ticket): String
  #separator(): String
  -safe(s: String): String
}
class HtmlTicketRenderer <<ConcreteClass>> {
  #header(reservation: Reservation, ticket: Ticket): String
  #body(reservation: Reservation, ticket: Ticket): String
  #footer(reservation: Reservation, ticket: Ticket): String
  #separator(): String
  -safe(s: String): String
}
class BoardingPassRenderer <<ConcreteClass>> {
  #header(reservation: Reservation, ticket: Ticket): String
  #body(reservation: Reservation, ticket: Ticket): String
  #footer(reservation: Reservation, ticket: Ticket): String
  #separator(): String
  -safe(s: String): String
}

' Keep the 3 children on one rank so the generalization fan stays symmetric and crossing-free.
PlainTextTicketRenderer -[hidden]right- HtmlTicketRenderer
HtmlTicketRenderer -[hidden]right- BoardingPassRenderer

' Generalizations: each ConcreteClass -|> AbstractClass.
TicketRenderer <|-- PlainTextTicketRenderer
TicketRenderer <|-- HtmlTicketRenderer
TicketRenderer <|-- BoardingPassRenderer

note bottom of TicketRenderer
  render() = final template method (fixed skeleton: header + separator + body + separator + footer).
  header/body/footer = abstract primitives — each ConcreteClass MUST override.
  separator() = default hook (returns "\n") — subclasses MAY override.
end note
@enduml
