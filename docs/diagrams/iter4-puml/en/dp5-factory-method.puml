@startuml dp5-factory-method
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype polyline
skinparam nodesep 26
skinparam ranksep 42
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  ArrowThickness 1
  FontColor #000000
  FontName "Helvetica Neue"
  AttributeFontColor #000000
  AttributeFontName "Helvetica Neue"
  StereotypeFontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #000000
}

title DP#5 Factory Method Pattern - Creator = PaymentMethodProcessor
abstract class PaymentMethodProcessor <<Creator>> {
  -paymentSequence: long
  -gateway: PaymentGatewayInterface
  --
  #PaymentMethodProcessor(gateway: PaymentGatewayInterface)
  +createPayment(): Payment
  +method(): PaymentMethod
  +processCharge(amount: long, reservationPnr: String): Payment
  #authorize(payment: Payment): boolean
  #declineReason(): String
  #nextPaymentId(): long
  #stamp(payment: Payment, amount: long): Payment
}
class CreditCardPaymentProcessor <<ConcreteCreator>> {
  +CreditCardPaymentProcessor(gateway: PaymentGatewayInterface)
  +createPayment(): Payment
  +method(): PaymentMethod
}
class MileagePaymentProcessor <<ConcreteCreator>> {
  -account: MileageAccount
  --
  +MileagePaymentProcessor(account: MileageAccount)
  +createPayment(): Payment
  +method(): PaymentMethod
  #authorize(payment: Payment): boolean
}
abstract class Payment <<Product>> {
  -paymentId: Long
  -amount: BigDecimal
  -paymentMethod: PaymentMethod
  -status: PaymentStatus
  -paidAt: LocalDateTime
  -refunds: List<Refund>
  --
  #Payment(paymentMethod: PaymentMethod)
  +getAmount(): BigDecimal
  +setAmount(amount: BigDecimal): void
  +getPaymentMethod(): PaymentMethod
  +getPaymentId(): Long
  +setPaymentId(paymentId: Long): void
  +getStatus(): PaymentStatus
  +getRefunds(): List<Refund>
  +pay(): void
  +fail(): void
  +addRefund(refund: Refund): void
  +isRefundable(): boolean
}
class CreditCardPayment <<ConcreteProduct>> {
  +CreditCardPayment()
}
class MileagePayment <<ConcreteProduct>> {
  +MileagePayment()
}
PaymentMethodProcessor <|-- CreditCardPaymentProcessor
PaymentMethodProcessor <|-- MileagePaymentProcessor
Payment <|-- CreditCardPayment
Payment <|-- MileagePayment
PaymentMethodProcessor ..> Payment : createPayment()
CreditCardPaymentProcessor ..> CreditCardPayment
MileagePaymentProcessor ..> MileagePayment
note bottom : 5 payment ConcreteCreators/Products and 3 itinerary ones follow the same structure (ApplePay, KakaoPay, BankTransfer; Direct, Connecting, MultiCity).
@enduml
