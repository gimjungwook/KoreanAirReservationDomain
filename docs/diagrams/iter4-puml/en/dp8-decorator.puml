@startuml dp8-decorator
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype polyline
skinparam nodesep 26
skinparam ranksep 42
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam class {
  BackgroundColor #FFFFCE
  BorderColor #000000
  BorderThickness 1
  ArrowColor #000000
  ArrowThickness 1
  FontColor #000000
  FontName "Helvetica Neue"
  AttributeFontColor #000000
  AttributeFontName "Helvetica Neue"
  StereotypeFontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #777777
  FontColor #000000
}

title DP#9 Decorator Pattern - SeatView
abstract class SeatView <<Component>> {
  +getSeat(): Seat
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
}
class BaseSeatView <<ConcreteComponent>> {
  -seat: Seat
  --
  +BaseSeatView(seat: Seat)
  +getSeat(): Seat
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
}
abstract class AbstractSeatDecorator <<Decorator>> {
  #component: SeatView
  --
  #AbstractSeatDecorator(component: SeatView)
  +getSeat(): Seat
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
}
class WindowSeatDecorator <<ConcreteDecorator>> {
  +WindowSeatDecorator(component: SeatView)
  +getDescription(): String
  +getMetadataLabels(): List<String>
  -addedBehavior(): String
}
class AisleSeatDecorator <<ConcreteDecorator>> {
  +AisleSeatDecorator(component: SeatView)
  +getDescription(): String
  +getMetadataLabels(): List<String>
  -addedBehavior(): String
}
class ExtraLegroomDecorator <<ConcreteDecorator>> {
  -SURCHARGE: BigDecimal {static}
  --
  +ExtraLegroomDecorator(component: SeatView)
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
  -addedBehavior(): String
}
class LoungeAccessDecorator <<ConcreteDecorator>> {
  -SURCHARGE: BigDecimal {static}
  --
  +LoungeAccessDecorator(component: SeatView)
  +getDescription(): String
  +getSurcharge(): BigDecimal
  +getMetadataLabels(): List<String>
  -addedBehavior(): String
}
' Inheritance edges stay vertical (Component on top, ConcreteComponent + Decorator
' below, the 4 ConcreteDecorators fanned beneath the abstract Decorator).
SeatView <|-- BaseSeatView
SeatView <|-- AbstractSeatDecorator
AbstractSeatDecorator <|-- WindowSeatDecorator
AbstractSeatDecorator <|-- AisleSeatDecorator
AbstractSeatDecorator <|-- ExtraLegroomDecorator
AbstractSeatDecorator <|-- LoungeAccessDecorator

' Decorator-wraps-Component aggregation: AbstractSeatDecorator HAS-A one SeatView
' (the protected final #component field). Anchored from the component field across to
' SeatView's left side so the diamond edge stays clear of the vertical inheritance
' triangle that joins the same two boxes; multiplicity reads 1 wrapped Component.
AbstractSeatDecorator::component "1" o-left- SeatView : component >

note bottom of AbstractSeatDecorator : ConcreteDecorators override an operation, call super (forwarding down the wrapped SeatView chain)\nand append addedBehavior; getDescription += " · 창가/통로", getSurcharge via super.getSurcharge().add(SURCHARGE)\n(ExtraLegroom +50,000 / Lounge +80,000), getMetadataLabels adds Window/Aisle/ExtraLegroom/Lounge.
@enduml
