@startuml dp4-composite
!include _style.puml
title DP#4 Composite - 공항(Leaf)과 도시(Composite) 동일 취급
interface AirportLocation <<Component>> #FFCCCC {
  +getCode(): String
  +getDisplayName(): String
  +getAirports(): List<Airport>
  +matches(): boolean
  +isComposite(): boolean
}
class Airport <<Leaf>> #FFCCCC {
  -airportCode: String
  -airportName: String
  -city: String
  -country: String
  --
  +getAirportCode(): String
  +getAirportName(): String
  +getCity(): String
  +getCountry(): String
  +getCode(): String
  +getDisplayName(): String
  +getAirports(): List<Airport>
  +matches(): boolean
  +isComposite(): boolean
}
class AirportCity <<Composite>> #FFCCCC {
  -cityCode: String
  -cityName: String
  -country: String
  -airports: List<Airport>
  --
  +add(): AirportCity
  +getCityCode(): String
  +getCityName(): String
  +getCountry(): String
  +getCode(): String
  +getDisplayName(): String
  +getAirports(): List<Airport>
  +matches(): boolean
  +isComposite(): boolean
}
class AirportCatalog #FFCCCC {
  -airportsByCode: Map<String,Airport>
  -citiesByCode: Map<String,AirportCity>
  --
  +registerAirport(): AirportCatalog
  +registerCity(): AirportCatalog
  +lookup(): AirportLocation
  +getMultiAirportCities(): List<AirportCity>
  +getAllAirports(): List<Airport>
}
AirportLocation <|.. Airport
AirportLocation <|.. AirportCity
AirportCity o--> "0..*" Airport
AirportCatalog ..> AirportLocation : lookup
note bottom of AirportCity : NYC = JFK + LGA + EWR
@enduml
