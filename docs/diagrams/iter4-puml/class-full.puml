@startuml class-full
!include _style.puml
title 대한항공 예약 시스템 - 전체 클래스 다이어그램 (ECB + 9 GoF 패턴)
left to right direction
package "Boundary (JavaFX)" {
  class FxApp {
    +start(): void
    +main(): void
  }
  class Navigator {
    +STEP_SEARCH: int
    +STEP_PASSENGER: int
    +STEP_SEAT: int
    +STEP_PAYMENT: int
    +STEP_DONE: int
    -ctx: AppContext
    -shell: ShellController
    --
    -load(): Loaded<T>
    +updateState(): void
    +showLogin(): void
    +showSearch(): void
    +showPassenger(): void
    +showPassengerRoundTrip(): void
    +showPassengerMultiCity(): void
    +showPassengerConnecting(): void
    +showPassengerExisting(): void
    +showSeat(): void
    +showPayment(): void
    +showConfirmation(): void
    +showLookup(): void
    +showCancellation(): void
    +showRefund(): void
    +showRefundReview(): void
    +showRegistration(): void
    +showSettings(): void
    +onLoginSuccess(): void
    +requireSignIn(): void
    +doLogout(): void
    +startNewBooking(): void
    +registerReservationToMember(): void
    +noop(): List<FlightSchedule>
  }
  interface SkypassInterface <<Target>> #FFCCCC {
    +verifyMembership(): Object
    +getMileageBalance(): int
    +deductMileage(): boolean
    +verifyAndDeduct(): Object
  }
  class SkypassAdapter <<Adapter>> #FFCCCC {
    -remoteApi: RemoteSkypassApi
    --
    +verifyMembership(): Object
    +getMileageBalance(): int
    +deductMileage(): boolean
    +verifyAndDeduct(): Object
  }
  class RemoteSkypassApi <<Adaptee>> #FFCCCC {
    -balances: Map<String,Integer>
    -tokens: Map<String,String>
    --
    +registerAccount(): void
    +postAuth(): Map<String,Object>
    +getMileage(): Map<String,Object>
    +postDeduct(): Map<String,Object>
  }
}
package "Control" {
  class BookingController {
    -authService: AuthService
    -flightSearch: FlightSearchService
    -paymentProcessor: PaymentProcessor
    -refundHandler: RefundHandler
    -lookupService: ReservationLookupService
    --
    +processSearch(): Object
    +initiateBooking(): Reservation
    +setPassengerInfo(): void
    +confirmInfo(): void
    +assignSeat(): void
    +assignSeat(): SeatAssignment
    -resolveBookingClass(): BookingClass
    +processCancellation(): void
    -resolveFareClass(): String
    +changeFlightStatus(): void
    +createSchedule(): FlightSchedule
    +authenticateAdmin(): boolean
    +authenticateMember(): Object
    +getBookingHistory(): Object
    +getTicketDetail(): Object
    +verifyGuestIdentity(): boolean
    +reconfirmGuestIdentity(): boolean
    +processSearch(): List<FlightSchedule>
    +getAllSchedules(): List<FlightSchedule>
    +initiateMultiCityBooking(): Reservation
    +initiateConnectingBooking(): Reservation
    +initiateRoundTripBooking(): Reservation
    +confirmPayment(): Payment
    +confirmPaymentWith(): Payment
    +confirmMileagePayment(): Payment
    +currentMember(): Member
    +airport(): Airport
  }
  class AuthService {
    -memberBySkypass: Map<String,Member>
    -passwordBySkypass: Map<String,String>
    -memberByName: Map<String,Member>
    -saltBySkypass: Map<String,String>
    -hashedPasswordBySkypass: Map<String,String>
    -memberSequence: int
    -current: Member
    --
    +registerSample(): void
    +registerMember(): Member
    +generateSkypassNumber(): String
    +loginByName(): Member
    +login(): Member
    +loginWithHash(): Member
    +verifyGuest(): boolean
    +logout(): void
    +currentMember(): Member
    -hashPassword(): String
    -generateSalt(): String
  }
  class FlightSearchService {
    -catalog: List<FlightSchedule>
    -airportCatalog: AirportCatalog
    --
    +getAirportCatalog(): AirportCatalog
    +addSchedule(): void
    +search(): List<FlightSchedule>
    +searchByLocation(): List<FlightSchedule>
    +getCatalog(): List<FlightSchedule>
  }
  class RefundHandler {
    -pending: Map<String,RefundRequest>
    -completed: Map<String,Refund>
    -requestToPnr: Map<String,String>
    -gateway: PaymentGatewayInterface
    -strategy: RefundPolicy
    -requestSeq: int
    -refundSeq: int
    -REFUND_YYMM: DateTimeFormatter
    --
    +setStrategy(): void
    +getStrategy(): RefundPolicy
    +evaluateRefund(): RefundRequest
    +processRefund(): void
    +denyRefund(): void
    +getRefundDetail(): RefundRequest
    +getPendingRequests(): List<RefundRequest>
    +previewRefund(): BigDecimal
    +previewPolicyName(): String
    -resolvePolicy(): RefundPolicy
    -resolveFareRuleFrom(): FareRule
    -synthesize(): FareRule
  }
  class PaymentProcessorFactory <<Factory>> #FFCCCC {
    +forMethod(): PaymentMethodProcessor
    +method(): PaymentMethod
  }
  abstract class PaymentMethodProcessor #FFCCCC {
    -paymentSequence: long
    -gateway: PaymentGatewayInterface
    --
    #createPayment(): Payment
    +method(): PaymentMethod
    +processCharge(): Payment
    #authorize(): boolean
    #declineReason(): String
    #nextPaymentId(): long
    #stamp(): Payment
  }
  abstract class ItineraryFactory <<Factory>> #FFCCCC {
    +build(): Itinerary
    #createItinerary(): Itinerary
    #validate(): void
    #postCheck(): void
  }
  abstract class TicketRenderer <<Template>> #FFCCCC {
    +render(): String
    #header(): String
    #body(): String
    #footer(): String
    #separator(): String
  }
  class TicketPurchasePublisher <<Subject>> {
    -subjectState: TicketIssuedEvent
    --
    +getState(): TicketIssuedEvent
    +setState(): void
    +publishTicketIssued(): void
  }
}
package "Domain :: reservation" {
  class Reservation <<Context>> {
    -reservationId: Long
    -reservationNumber: String
    -requester: User
    -status: ReservationStatus
    -createdAt: LocalDateTime
    -reservationDate: LocalDateTime
    -itinerary: Itinerary
    -passengers: List<Passenger>
    -reservationItems: List<ReservationItem>
    -payments: List<Payment>
    -tickets: List<Ticket>
    -REGISTRY: Map<String,Reservation>
    -currentState: ReservationState
    --
    +getReservationId(): Long
    +getReservationNumber(): String
    +getRequester(): User
    +getStatus(): ReservationStatus
    +getPassengers(): List<Passenger>
    +getReservationItems(): List<ReservationItem>
    +getPayments(): List<Payment>
    +getTickets(): List<Ticket>
    +getItinerary(): Itinerary
    +addPassenger(): void
    +addReservationItem(): void
    +addPayment(): void
    +addTicket(): void
    +confirmReservation(): void
    +issueTickets(): void
    +cancelReservation(): void
    +canBeCancelled(): boolean
    +requestRefund(): Refund
    +evaluateImpactOfFlightStatusChange(): void
    +create(): Reservation
    +updatePassengerInfo(): void
    +updateStatus(): void
    +findByPnr(): Reservation
    +getContactEmail(): String
    +getReservationDetail(): Reservation
    +setState(): void
    +getCurrentState(): ReservationState
    +getStateName(): String
    +enterPassengerInfo(): void
    +processPayment(): void
    +handlePaymentFailure(): void
    +issueTicket(): void
    +requestCancellation(): void
    +confirmCancellation(): void
    +requestRefund(): void
    +processRefundDecision(): void
    +setReservationNumber(): void
    +setRequester(): void
    +getPnrNumber(): String
    +getCreatedAt(): LocalDateTime
    +getReservationDate(): LocalDateTime
  }
  interface ReservationState <<State>> {
    +name(): String
  }
  abstract class Itinerary {
    +DOMESTIC_MCT: Duration
    +INTERNATIONAL_MCT: Duration
    -tripType: String
    -segments: List<Segment>
    --
    +getTripType(): String
    +setTripType(): void
    +getSegments(): List<Segment>
    +addSegment(): void
    +isConnectionTimeValid(): boolean
    +getTotalDuration(): Duration
    +direct(): Itinerary
    +connecting(): Itinerary
    +multiCity(): Itinerary
  }
}
package "Domain :: payment" {
  interface RefundPolicy <<Strategy>> {
    +calculateRefundAmount(): BigDecimal
    +getRefundType(): String
  }
  abstract class Payment {
    -paymentId: Long
    -amount: BigDecimal
    -paymentMethod: PaymentMethod
    -status: PaymentStatus
    -paidAt: LocalDateTime
    -refunds: List<Refund>
    --
    +getAmount(): BigDecimal
    +setAmount(): void
    +getPaymentMethod(): PaymentMethod
    +setPaymentMethod(): void
    +getPaymentId(): Long
    +setPaymentId(): void
    +getStatus(): PaymentStatus
    +getRefunds(): List<Refund>
    +pay(): void
    +fail(): void
    +addRefund(): void
    +isRefundable(): boolean
  }
}
package "Domain :: flight" {
  abstract class AirportLocation <<Composite>> #FFCCCC {
    +getCode(): String
    +getDisplayName(): String
    +getAirports(): List<Airport>
    +matches(): boolean
    +isComposite(): boolean
  }
  class AirportCity #FFCCCC {
    -cityCode: String
    -cityName: String
    -country: String
    -components: List<AirportLocation>
    --
    +addComponent(): void
    +removeComponent(): void
    +getCityCode(): String
    +getCityName(): String
    +getCountry(): String
    +getCode(): String
    +getDisplayName(): String
    +getAirports(): List<Airport>
    +matches(): boolean
    +isComposite(): boolean
  }
  class Airport #FFCCCC {
    -airportCode: String
    -airportName: String
    -city: String
    -country: String
    --
    +getAirportCode(): String
    +getAirportName(): String
    +getCity(): String
    +getCountry(): String
    +getCode(): String
    +getDisplayName(): String
    +getAirports(): List<Airport>
    +matches(): boolean
    +isComposite(): boolean
  }
  abstract class SeatView <<Decorator>> #FFCCCC {
    +getSeat(): Seat
    +getDescription(): String
    +getSurcharge(): BigDecimal
    +getMetadataLabels(): List<String>
  }
}
package "Domain :: event" {
  interface EventListener {
    +onEvent(): void
  }
  abstract class DomainEvent {
    -occurredAt: LocalDateTime
    -sourceId: String
    --
    +getOccurredAt(): LocalDateTime
    +getSourceId(): String
    +getEventType(): String
  }
}
package "app" {
  class AppConfig <<Singleton>> #FFCCCC {
    -instance: AppConfig
    -fontFamily: String
    -fontSize: int
    -displayLocale: Locale
    -currency: Currency
    -modernTheme: boolean
    -showSeatMetadata: boolean
    -listeners: List<Consumer<AppConfig>>
    --
    +getInstance(): AppConfig
    +getFontFamily(): String
    +setFontFamily(): void
    +getFontSize(): int
    +setFontSize(): void
    +getDisplayLocale(): Locale
    +setDisplayLocale(): void
    +getCurrency(): Currency
    +setCurrency(): void
    +isModernTheme(): boolean
    +setModernTheme(): void
    +isShowSeatMetadata(): boolean
    +setShowSeatMetadata(): void
    +addChangeListener(): void
    +removeChangeListener(): void
    -notifyListeners(): void
  }
}
FxApp --> Navigator
Navigator ..> BookingController
BookingController --> Reservation
BookingController ..> PaymentProcessorFactory
BookingController ..> ItineraryFactory
PaymentProcessorFactory ..> PaymentMethodProcessor
Reservation o--> ReservationState
Reservation --> Itinerary
RefundHandler ..> RefundPolicy
FlightSearchService ..> AirportLocation
AirportCity o--> AirportLocation
SkypassInterface <|.. SkypassAdapter
SkypassAdapter --> RemoteSkypassApi
TicketPurchasePublisher o--> EventListener
TicketRenderer ..> Reservation
FxApp ..> AppConfig
legend bottom
|= 색 |= 의미 |
|<#FFCCCC>    | iter4 신규 적용 패턴 (Composite/Singleton/Factory Method/Template Method/Adapter/Decorator) |
|<#FFFFCE>    | iter1-3 기존 패턴 (State/Strategy/Observer) + 인프라 |
endlegend
@enduml
