@startuml dp6-factory-method
!include _style.puml
title DP#6 Factory Method - 결제수단/여정 생성 위임
abstract class PaymentMethodProcessor <<Product>> #FFCCCC {
  -paymentSequence: long
  -gateway: PaymentGatewayInterface
  --
  #createPayment(): Payment
  +method(): PaymentMethod
  +processCharge(): Payment
  #authorize(): boolean
  #declineReason(): String
  #nextPaymentId(): long
  #basePayment(): Payment
}
class PaymentProcessorFactory <<Creator>> #FFCCCC {
  +forMethod(): PaymentMethodProcessor
  +method(): PaymentMethod
}
class CreditCardPaymentProcessor #FFCCCC {
  #createPayment(): Payment
  +method(): PaymentMethod
}
class KakaoPayPaymentProcessor #FFCCCC {
  #createPayment(): Payment
  +method(): PaymentMethod
  #declineReason(): String
}
class ApplePayPaymentProcessor #FFCCCC {
  #createPayment(): Payment
  +method(): PaymentMethod
  #declineReason(): String
}
class BankTransferPaymentProcessor #FFCCCC {
  #createPayment(): Payment
  +method(): PaymentMethod
  #declineReason(): String
}
class MileagePaymentProcessor #FFCCCC {
  -account: MileageAccount
  --
  #createPayment(): Payment
  +method(): PaymentMethod
  +processCharge(): Payment
}
abstract class ItineraryFactory <<Creator>> #FFCCCC {
  +build(): Itinerary
  #createItinerary(): Itinerary
  #validate(): void
  #postCheck(): void
}
class DirectItineraryFactory #FFCCCC {
  #createItinerary(): Itinerary
  #validate(): void
}
class ConnectingItineraryFactory #FFCCCC {
  -mct: Duration
  --
  #createItinerary(): Itinerary
  #validate(): void
  #postCheck(): void
}
class MultiCityItineraryFactory #FFCCCC {
  #createItinerary(): Itinerary
  #validate(): void
}
PaymentMethodProcessor <|-- CreditCardPaymentProcessor
PaymentMethodProcessor <|-- KakaoPayPaymentProcessor
PaymentMethodProcessor <|-- ApplePayPaymentProcessor
PaymentMethodProcessor <|-- BankTransferPaymentProcessor
PaymentMethodProcessor <|-- MileagePaymentProcessor
PaymentProcessorFactory ..> PaymentMethodProcessor : creates
ItineraryFactory <|-- DirectItineraryFactory
ItineraryFactory <|-- ConnectingItineraryFactory
ItineraryFactory <|-- MultiCityItineraryFactory
@enduml
