@startuml sequence-reservation-main
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName "Helvetica Neue"
skinparam defaultFontSize 13
skinparam dpi 150
skinparam ArrowColor #000000
skinparam ArrowThickness 1
skinparam UsecaseBackgroundColor #FFFFCE
skinparam UsecaseBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ActorFontColor #000000
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleBorderColor #000000
skinparam StateBackgroundColor #FFFFCE
skinparam StateBorderColor #000000
skinparam ParticipantBackgroundColor #FFFFCE
skinparam ParticipantBorderColor #000000
skinparam LifelineBorderColor #000000
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #777777
skinparam sequenceMessageAlign first
skinparam maxMessageSize 240

title Sequence Diagram - Reservation, Payment, Ticketing (cumulative)

actor Customer
participant "BookingController" as BC
participant "PaymentProcessorFactory" as FAC
participant "PaymentMethodProcessor\n(ConcreteCreator)" as PMP
participant "Payment\n(ConcreteProduct)" as PAY
participant "Reservation" as RES
participant ":ReservationState" as ST
participant "AppContext\n(orchestrator)" as ORC
participant "TicketPurchasePublisher" as PUB
participant "BusTicketPurchaseListener" as OBS
participant "BusTicketingService" as SVC

== Payment leg : BookingController.confirmPaymentWith ==

Customer -> BC : confirmPaymentWith(reservation, fareRule,\nbaseFare, tax, method, gateway, mileageAccount)
activate BC
BC -> BC : validateFareRule(fareRule)
BC -> BC : calculateTotalAmount(baseFare, tax)

BC -> FAC : forMethod(method, gateway, mileageAccount)
activate FAC
create PMP
FAC -> PMP : <color:#C00000>new ConcreteCreator(gateway)</color>
FAC --> BC : PaymentMethodProcessor
deactivate FAC

BC -> PMP : processCharge(amount, pnr)
activate PMP
create PAY
PMP -> PAY : <color:#C00000>createPayment()  // factory method DP#5, no-arg</color>\n<color:#C00000>(returns new CreditCardPayment)</color>
note right of PMP : createPayment() IS the instantiation\n(ConcreteCreator returns new CreditCardPayment()).
PMP -> PAY : stamp(payment, amount)
PMP -> PAY : pay()
PMP --> BC : Payment (PAID)
deactivate PMP

BC -> RES : addPayment(payment)
BC -> RES : processPayment()
activate RES
RES -> ST : processPayment(this)
note over ST : currentState = PendingPaymentState
ST -> RES : setState(ConfirmedState)
deactivate RES
BC --> Customer : Payment
deactivate BC

== Ticketing + Observer leg : AppContext.issueLinkedBusTicket (orchestrator, not BC) ==

Customer -> ORC : <color:#C00000>issueLinkedBusTicket(reservation, req)</color>
activate ORC
ORC -> RES : issueTicket()
activate RES
RES -> ST : issueTicket(this)
note over ST : currentState = ConfirmedState
ST -> RES : setState(TicketedState)
deactivate RES

ORC -> PUB : <color:#C00000>publishTicketIssued(reservation, airTicket, req)</color>
activate PUB
PUB -> PUB : <color:#C00000>setState(TicketIssuedEvent)  // store + notifyObservers()</color>
PUB -> OBS : <color:#C00000>update()  // PULL model (DP#2), no-arg</color>
activate OBS
OBS -> PUB : <color:#C00000>getState()  // observer pulls TicketIssuedEvent</color>
OBS -> SVC : <color:#C00000>issuePremiumTicket(reservation, airTicket,</color>\n<color:#C00000>originCity, schedule, seat)</color>
activate SVC
SVC --> OBS : BusTicket
deactivate SVC
deactivate OBS
deactivate PUB
ORC --> Customer : BusTicket
deactivate ORC

@enduml
